<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_16">

    <!-- Daily Weather First Info -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutDailyWeatherFirstInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_daily_weather_item"
        android:padding="@dimen/dp_16"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_16"
                tools:text="Hôm nay" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:textColor="@color/text_status"
                android:textSize="@dimen/sp_16"
                tools:text="Có mây và nắng" />

        </LinearLayout>

        <ImageView
            android:id="@+id/ivWeatherIcon"
            android:layout_width="@dimen/dp_56"
            android:layout_height="@dimen/dp_56"
            android:layout_marginEnd="@dimen/dp_12"
            android:src="@drawable/ic_cloud_and_sun"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/ivExpand"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivExpand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_expand_close"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Daily Weather Second Info -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutDailyWeatherSecondInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:background="@drawable/bg_daily_weather_item"
        android:padding="@dimen/dp_16"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/layoutDailyWeatherFirstInfo">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_daily_weather"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/layoutWeatherDetailsFirstRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle">

            <!-- Wind Speed -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/weather_card_detail"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/dp_12">

                <ImageView
                    android:id="@+id/ivWindSpeed"
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:background="@drawable/ic_bg_white"
                    android:padding="@dimen/dp_4"
                    android:src="@drawable/ic_windy"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvWindSpeedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:text="@string/wind_speed"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/sp_14"
                    app:layout_constraintLeft_toRightOf="@+id/ivWindSpeed"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvWindSpeedValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/home_wind_speed_value"
                    android:textAlignment="textEnd"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/sp_16"
                    app:layout_constraintLeft_toRightOf="@+id/ivWindSpeed"
                    app:layout_constraintTop_toBottomOf="@+id/tvWindSpeedLabel" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="@dimen/dp_8"
                android:layout_height="@dimen/dp_0" />

            <!-- Humidity -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/weather_card_detail"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/dp_12">

                <ImageView
                    android:id="@+id/ivHumidity"
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:background="@drawable/ic_bg_white"
                    android:padding="@dimen/dp_4"
                    android:src="@drawable/ic_rain"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvHumidityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:text="@string/humidity"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/sp_14"
                    app:layout_constraintLeft_toRightOf="@+id/ivHumidity"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvHumidityValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/home_humidity_value"
                    android:textAlignment="textEnd"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/sp_16"
                    app:layout_constraintLeft_toRightOf="@+id/ivHumidity"
                    app:layout_constraintTop_toBottomOf="@+id/tvHumidityLabel" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutWeatherDetailsSecondRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/layoutWeatherDetailsFirstRow">

            <!-- Pressure -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/weather_card_detail"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/dp_12">

                <ImageView
                    android:id="@+id/ivPressure"
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:background="@drawable/ic_bg_white"
                    android:padding="@dimen/dp_4"
                    android:src="@drawable/ic_pressure"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvPressureLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_weight="1"
                    android:text="@string/pressure"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/sp_14"
                    app:layout_constraintLeft_toRightOf="@+id/ivPressure" />

                <TextView
                    android:id="@+id/tvPressureValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/home_pressure_value"
                    android:textAlignment="textEnd"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/sp_16"
                    app:layout_constraintLeft_toRightOf="@+id/ivPressure"
                    app:layout_constraintTop_toBottomOf="@+id/tvPressureLabel" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="@dimen/dp_8"
                android:layout_height="@dimen/dp_0" />

            <!-- UV Index -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/weather_card_detail"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/dp_12">

                <ImageView
                    android:id="@+id/ivUvIndex"
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:background="@drawable/ic_bg_white"
                    android:padding="@dimen/dp_4"
                    android:src="@drawable/ic_rain"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvUvIndexLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_weight="1"
                    android:text="@string/uv_index"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/sp_14"
                    app:layout_constraintLeft_toRightOf="@+id/ivUvIndex" />

                <TextView
                    android:id="@+id/tvUvIndexValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/home_humidity_value"
                    android:textAlignment="textEnd"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/sp_16"
                    app:layout_constraintLeft_toRightOf="@+id/ivUvIndex"
                    app:layout_constraintTop_toBottomOf="@+id/tvUvIndexLabel" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutWeatherDetailsThirdRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/layoutWeatherDetailsSecondRow">

            <!-- Sun rise -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/weather_card_detail"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/dp_12">

                <ImageView
                    android:id="@+id/ivSunrise"
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:background="@drawable/ic_bg_white"
                    android:padding="@dimen/dp_4"
                    android:src="@drawable/ic_rise"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvSunriseLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_weight="1"
                    android:text="@string/sun_sise"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/sp_14"
                    app:layout_constraintLeft_toRightOf="@+id/ivSunrise" />

                <TextView
                    android:id="@+id/tvSunriseValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/home_pressure_value"
                    android:textAlignment="textEnd"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/sp_16"
                    app:layout_constraintLeft_toRightOf="@+id/ivSunrise"
                    app:layout_constraintTop_toBottomOf="@+id/tvSunriseLabel" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="@dimen/dp_8"
                android:layout_height="@dimen/dp_0" />

            <!-- Sun set -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/weather_card_detail"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/dp_12">

                <ImageView
                    android:id="@+id/ivSunset"
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:background="@drawable/ic_bg_white"
                    android:padding="@dimen/dp_4"
                    android:src="@drawable/ic_set"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvSunsetLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_weight="1"
                    android:text="@string/sun_set"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/sp_14"
                    app:layout_constraintLeft_toRightOf="@+id/ivSunset" />

                <TextView
                    android:id="@+id/tvSunsetValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/home_humidity_value"
                    android:textAlignment="textEnd"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/sp_16"
                    app:layout_constraintLeft_toRightOf="@+id/ivSunset"
                    app:layout_constraintTop_toBottomOf="@+id/tvSunsetLabel" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutWeatherDetailsFourthRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/layoutWeatherDetailsThirdRow">

            <!-- Sun rise -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/weather_card_detail"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/dp_12">

                <ImageView
                    android:id="@+id/ivMoonrise"
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:background="@drawable/ic_bg_white"
                    android:padding="@dimen/dp_4"
                    android:src="@drawable/ic_rise"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvMoonriseLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_weight="1"
                    android:text="@string/moon_rise"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/sp_14"
                    app:layout_constraintLeft_toRightOf="@+id/ivMoonrise" />

                <TextView
                    android:id="@+id/tvMoonriseValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/home_pressure_value"
                    android:textAlignment="textEnd"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/sp_16"
                    app:layout_constraintLeft_toRightOf="@+id/ivMoonrise"
                    app:layout_constraintTop_toBottomOf="@+id/tvMoonriseLabel" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="@dimen/dp_8"
                android:layout_height="@dimen/dp_0" />

            <!-- Sun set -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/weather_card_detail"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/dp_12">

                <ImageView
                    android:id="@+id/ivMoonset"
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:background="@drawable/ic_bg_white"
                    android:padding="@dimen/dp_4"
                    android:src="@drawable/ic_set"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvMoonsetLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_weight="1"
                    android:text="@string/moon_set"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/sp_14"
                    app:layout_constraintLeft_toRightOf="@+id/ivMoonset" />

                <TextView
                    android:id="@+id/tvMoonsetValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/home_humidity_value"
                    android:textAlignment="textEnd"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/sp_16"
                    app:layout_constraintLeft_toRightOf="@+id/ivMoonset"
                    app:layout_constraintTop_toBottomOf="@+id/tvMoonsetLabel" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <!-- Temperature Chart Section -->
        <TextView
            android:id="@+id/tvTempChartTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/temperature_chart_24h"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutWeatherDetailsFourthRow" />

        <com.sun.weatherapp.screen.widget.ChartView
            android:id="@+id/tempChart"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTempChartTitle" />

        <!-- Rain Probability Section -->
        <LinearLayout
            android:id="@+id/layoutRainSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tempChart">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="@dimen/dp_8"
                android:src="@drawable/ic_rain" />

            <TextView
                android:id="@+id/tvRainProbabilityTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rain_probability"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHourlyRainProbability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:nestedScrollingEnabled="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutRainSection" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
