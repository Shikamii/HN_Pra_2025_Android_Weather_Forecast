<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_auth_background"
    tools:context=".screen.auth.login.LoginFragment">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:text="@string/app_name"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="@dimen/sp_48"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginStart="@dimen/dp_16"
        tools:ignore="UnusedAttribute" />

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/login"
        android:textSize="@dimen/sp_32"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/llForm"
        tools:ignore="MissingConstraints" />

    <LinearLayout
        android:id="@+id/llForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="@dimen/dp_16"
        android:background="@drawable/form_auth_background"
        app:layout_constraintBottom_toTopOf="@+id/llRegister"
        tools:context=".MainActivity">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp_16"
            app:boxStrokeColor="@color/purple"
            app:boxBackgroundMode="outline"
            app:startIconDrawable="@drawable/icon_email"
            app:shapeAppearanceOverlay="@style/Widget.TextInputLayout.Rounded10">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/email"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:boxStrokeColor="@color/purple"
            app:passwordToggleEnabled="true"
            app:boxBackgroundMode="outline"
            app:startIconDrawable="@drawable/icon_password"
            app:shapeAppearanceOverlay="@style/Widget.TextInputLayout.Rounded10">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/password"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbRememberPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_8"
            android:text="@string/remember_password"
            app:buttonTint="@color/purple" />

        <TextView
            android:id="@+id/btnLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login"
            android:background="@drawable/button_auth_background"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:paddingVertical="@dimen/dp_8"
            android:paddingHorizontal="@dimen/dp_32"
            android:layout_gravity="right"
            tools:ignore="RtlHardcoded,UnusedAttribute" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llRegister"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@+id/tvVersion"
        android:layout_marginBottom="@dimen/dp_8"
        tools:context=".MainActivity">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:text="@string/not_account"
            android:textColor="@color/black"
            android:textStyle="normal"
            android:textSize="@dimen/sp_12"
            tools:ignore="HardcodedText,UnusedAttribute" />

        <TextView
            android:id="@id/btnRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:text="@string/register"
            android:textColor="@color/purple"
            android:textStyle="normal"
            android:textSize="@dimen/sp_12"
            android:layout_marginStart="@dimen/dp_4"
            tools:ignore="HardcodedText,UnusedAttribute" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:text="@string/version"
        android:textColor="@color/black"
        android:textStyle="normal"
        android:textSize="@dimen/sp_12"
        android:gravity="center"
        android:layout_marginBottom="@dimen/dp_8"
        tools:ignore="HardcodedText,UnusedAttribute" />

</androidx.constraintlayout.widget.ConstraintLayout>
